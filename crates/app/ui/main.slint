import { Slider } from "std-widgets.slint";

// Tokyo Night palette
export global Theme {
    out property <color> bg: #1a1b26;
    out property <color> surface: #24283b;
    out property <color> accent: #7aa2f7;
    out property <color> text: #c0caf5;
    out property <color> urgent: #f7768e;
}

component ToolButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();
    min-width: 40px;
    min-height: 40px;
    border-radius: 6px;
    background: !enabled ? transparent : active ? Theme.accent : ta.has-hover ? #2f354d : Theme.surface;
    Text {
        text: label;
        color: !enabled ? #565f89 : active ? Theme.bg : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Inkwell";
    min-width: 640px;
    min-height: 420px;
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Theme.bg;

    in property <image> frame;
    in property <string> tool: "pen";        // pen | highlighter | eraser
    in property <string> mode: "math";       // math | drawing
    in property <bool> pixel-erase: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <float> smoothing: 0.5;
    in property <float> stroke-width: 3.0;
    in property <string> status: "";
    in-out property <float> ui-scale: 1.0;

    callback canvas-resized(length, length);
    callback pointer-down(length, length);
    callback pointer-move(length, length);
    callback pointer-up();
    callback zoom(float, length, length);
    callback pan(length, length);
    callback set-tool(string);
    callback set-mode(string);
    callback toggle-pixel-erase();
    callback undo();
    callback redo();
    callback clear-all();
    callback set-smoothing(float);
    callback set-width(float);
    callback set-color(int);
    callback recognize-now();
    callback pen-lifted();
    callback set-delay(float);
    in property <float> recog-delay: 600;
    in property <[string]> candidates;
    in property <string> expr-text;
    in property <bool> training: false;
    in property <string> train-label;
    in property <string> train-info;
    callback choose(int);
    callback cycle-paper();
    callback set-spacing(float);
    in property <string> paper-name: "Lined";
    in property <float> paper-spacing: 32;
    callback toggle-training();
    callback train-step(int);
    callback train-unfilled();

    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.modifiers.control && e.text == "z" { root.undo(); root.pen-lifted(); return accept; }
            if e.modifiers.control && e.text == "y" { root.redo(); root.pen-lifted(); return accept; }
            if !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                if e.text == "1" { root.choose(0); return accept; }
                if e.text == "2" { root.choose(1); return accept; }
                if e.text == "3" { root.choose(2); return accept; }
                if e.text == "4" { root.choose(3); return accept; }
                if e.text == "5" { root.choose(4); return accept; }
            }
            reject
        }
    VerticalLayout {
        Rectangle {
            background: Theme.surface;
            height: 56px;
            HorizontalLayout {
                padding: 8px;
                spacing: 6px;
                ToolButton { label: "Pen"; active: root.tool == "pen"; clicked => { root.set-tool("pen"); } }
                ToolButton { label: "Highlight"; active: root.tool == "highlighter"; clicked => { root.set-tool("highlighter"); } }
                ToolButton { label: "Eraser"; active: root.tool == "eraser"; clicked => { root.set-tool("eraser"); } }
                ToolButton { label: root.pixel-erase ? "Pixel" : "Stroke"; clicked => { root.toggle-pixel-erase(); } }
                Rectangle { width: 12px; }
                ToolButton { label: "Math/Text"; active: root.mode == "math"; clicked => { root.set-mode("math"); } }
                ToolButton { label: "Drawing"; active: root.mode == "drawing"; clicked => { root.set-mode("drawing"); } }
                Rectangle { width: 12px; }
                ToolButton { label: "Undo"; enabled: root.can-undo; clicked => { root.undo(); root.pen-lifted(); } }
                ToolButton { label: "Redo"; enabled: root.can-redo; clicked => { root.redo(); root.pen-lifted(); } }
                ToolButton { label: "Clear"; clicked => { root.clear-all(); root.pen-lifted(); } }
                ToolButton { label: "Recognize"; clicked => { root.recognize-now(); } }
                ToolButton { label: "Paper: " + root.paper-name; clicked => { root.cycle-paper(); } }
                ToolButton { label: "Train"; active: root.training; clicked => { root.toggle-training(); } }
                for c[i] in [#c0caf5, #f7768e, #9ece6a, #7aa2f7, #e0af68, #bb9af7] : Rectangle {
                    width: 40px; height: 40px; border-radius: 20px; background: c;
                    TouchArea { clicked => { root.set-color(i); } }
                }
            }
        }
        Rectangle {
            background: Theme.surface;
            height: 44px;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 10px;
                Text { text: "Smoothing " + Math.round(root.smoothing * 100) + "%"; color: Theme.text; vertical-alignment: center; }
                Slider {
                    width: 160px; minimum: 0; maximum: 1; value: root.smoothing;
                    changed(v) => { root.set-smoothing(v); }
                }
                Text { text: "Width " + Math.round(root.stroke-width * 10) / 10; color: Theme.text; vertical-alignment: center; }
                Slider {
                    width: 160px; minimum: 0.5; maximum: 24; value: root.stroke-width;
                    changed(v) => { root.set-width(v); }
                }
                Text { text: "Spacing " + Math.round(root.paper-spacing); color: Theme.text; vertical-alignment: center; }
                Slider {
                    width: 120px; minimum: 12; maximum: 96; value: root.paper-spacing;
                    changed(v) => { root.set-spacing(v); }
                }
                Text { text: "Recognize after " + Math.round(root.recog-delay) + " ms"; color: Theme.text; vertical-alignment: center; }
                Slider {
                    width: 140px; minimum: 200; maximum: 2000; value: root.recog-delay;
                    changed(v) => { root.set-delay(v); }
                }
                Text { text: root.status; color: Theme.accent; vertical-alignment: center; }
            }
        }
        Rectangle {
            background: #1f2335;
            height: 60px;
            HorizontalLayout {
                padding: 6px; spacing: 6px;
                if !root.training : HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Candidates"; color: #565f89; vertical-alignment: center; }
                    for c[i] in root.candidates : Rectangle {
                        width: 72px; height: 48px; border-radius: 6px;
                        background: cta.has-hover ? #2f354d : Theme.surface;
                        Text { x: 6px; y: 4px; text: i + 1; color: #565f89; font-size: 11px; }
                        Text { text: c; color: i == 0 ? Theme.accent : Theme.text; font-size: 26px; horizontal-alignment: center; vertical-alignment: center; }
                        cta := TouchArea { clicked => { root.choose(i); } }
                    }
                    Text { text: root.expr-text; color: Theme.text; vertical-alignment: center; }
                }
                if root.training : HorizontalLayout {
                    spacing: 8px;
                    ToolButton { label: "<"; clicked => { root.train-step(-1); } }
                    Text { text: root.train-label; color: Theme.accent; font-size: 30px; vertical-alignment: center; min-width: 48px; horizontal-alignment: center; }
                    ToolButton { label: ">"; clicked => { root.train-step(1); } }
                    ToolButton { label: "Next unfilled"; clicked => { root.train-unfilled(); } }
                    Text { text: "Draw this symbol, then pause: " + root.train-info; color: Theme.text; vertical-alignment: center; }
                }
            }
        }
        canvas := Rectangle {
            background: Theme.bg;
            clip: true;
            changed width => { root.canvas-resized(self.width, self.height); }
            changed height => { root.canvas-resized(self.width, self.height); }
            Image { source: root.frame; width: parent.width; height: parent.height; image-fit: fill; }
            ta := TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        if e.button == PointerEventButton.left { root.pointer-down(self.mouse-x, self.mouse-y); }
                    } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                        root.pointer-up();
                    }
                }
                moved => { root.pointer-move(self.mouse-x, self.mouse-y); }
                scroll-event(e) => {
                    if e.modifiers.control {
                        root.zoom(e.delta-y > 0 ? 1.1 : 1 / 1.1, self.mouse-x, self.mouse-y);
                    } else {
                        root.pan(e.delta-x, e.delta-y);
                    }
                    accept
                }
            }
        }
    }
    }
}
